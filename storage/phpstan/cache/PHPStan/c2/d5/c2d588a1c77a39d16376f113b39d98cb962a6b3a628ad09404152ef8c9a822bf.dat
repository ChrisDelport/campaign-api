 * Record duplicate attempts — idempotently.
 *
 * Idempotency: an md5 hash of the (campaign, user_id set) is stored in
 * duplicate_logs.meta.log_key and checked before insert. A retried job
 * computes the same key and short-circuits, so at-least-once queue
 * delivery never double-counts duplicates in analytics.
 *
 * The snapshot comes from campaign_data (post-upsert) so the log row
 * reflects the data that actually survived, via getRawOriginal() to
 * reuse the stored JSON string instead of re-encoding through casts.
 *
 * @param  list<string>  $userIds
 */";s:9:"startLine";i:157;s:7:"endLine";i:202;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:8:"App\Jobs";s:18:"declaringClassName";s:33:"App\Jobs\StoreCampaignDataRecords";s:21:"implementingClassName";s:33:"App\Jobs\StoreCampaignDataRecords";s:16:"currentClassName";s:33:"App\Jobs\StoreCampaignDataRecords";s:9:"aliasName";N;}s:6:"failed";a:20:{s:4:"name";s:6:"failed";s:10:"parameters";a:1:{s:9:"exception";a:13:{s:4:"name";s:9:"exception";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:9:"Throwable";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:212;s:7:"endLine";i:212;s:11:"startColumn";i:28;s:9:"endColumn";i:47;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:356:"/**
