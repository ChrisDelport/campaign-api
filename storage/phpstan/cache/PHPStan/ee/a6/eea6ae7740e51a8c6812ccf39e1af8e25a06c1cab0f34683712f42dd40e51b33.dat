 * GET /api/campaigns — list campaigns, newest first.
 *
 * with('client') eager-loads the relationship to avoid an N+1: without
 * it, serialising N campaigns through CampaignResource would fire N
 * extra queries if/when the resource exposes client data.
 */";s:9:"startLine";i:40;s:7:"endLine";i:45;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:24:"App\Http\Controllers\Api";s:18:"declaringClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:21:"implementingClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:16:"currentClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:9:"aliasName";N;}s:5:"store";a:20:{s:4:"name";s:5:"store";s:10:"parameters";a:1:{s:7:"request";a:13:{s:4:"name";s:7:"request";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:38:"App\Http\Requests\StoreCampaignRequest";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:55;s:7:"endLine";i:55;s:11:"startColumn";i:27;s:9:"endColumn";i:55;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:28:"Illuminate\Http\JsonResponse";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:345:"/**
 * POST /api/campaigns — create a campaign for a client.
 *
 * StoreCampaignRequest has validated client_id (exists), name, and the
 * date pair (end_date optional, never before start_date). Creating is
 * synchronous and cheap — a single INSERT — so no queueing is needed
 * here; the async path is reserved for bulk data imports.
 */";s:9:"startLine";i:55;s:7:"endLine";i:62;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:24:"App\Http\Controllers\Api";s:18:"declaringClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:21:"implementingClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:16:"currentClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:9:"aliasName";N;}s:10:"importData";a:20:{s:4:"name";s:10:"importData";s:10:"parameters";a:2:{s:8:"campaign";a:13:{s:4:"name";s:8:"campaign";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:19:"App\Models\Campaign";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:79;s:7:"endLine";i:79;s:11:"startColumn";i:32;s:9:"endColumn";i:49;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"request";a:13:{s:4:"name";s:7:"request";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:43:"App\Http\Requests\ImportCampaignDataRequest";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:79;s:7:"endLine";i:79;s:11:"startColumn";i:52;s:9:"endColumn";i:85;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:28:"Illuminate\Http\JsonResponse";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:745:"/**
 * POST /api/campaigns/{campaign}/data — bulk import, the hot path.
 *
 * Three steps, none of which touch the MySQL write path:
 *  1. Route-model binding resolves {campaign} (404s if unknown).
 *  2. ImportCampaignDataRequest has already normalised the bare JSON
 *     array into 'records' and validated shape/URLs/caps synchronously —
 *     bad payloads are rejected here, before any queue traffic.
 *  3. The job is serialised (payload only — no Eloquent models) and
 *     pushed to Redis. This is the only I/O of consequence.
 *
 * The 'queued' count in the response gives the caller immediate,
 * deterministic feedback about what was accepted — useful for client
 *-side reconciliation since processing is asynchronous.
 */";s:9:"startLine";i:79;s:7:"endLine";i:90;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:24:"App\Http\Controllers\Api";s:18:"declaringClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:21:"implementingClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:16:"currentClassName";s:43:"App\Http\Controllers\Api\CampaignController";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}