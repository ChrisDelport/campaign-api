 * Surface custom_fields for analytics, per the assessment requirement.
 *
 * --field=a --field=b pins the reported keys; without it, keys are
 * auto-detected by scanning every JSON blob once. data_get() supports
 * dot notation (--field=user.email), so nested fields surface too.
 *
 * Trade-off: auto-detection and value collection are client-side PHP
 * over the campaign's rows. Fine for a CLI report; for huge datasets,
 * push this to MySQL (JSON_TABLE / generated columns).
 */";s:9:"startLine";i:77;s:7:"endLine";i:122;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:20:"App\Console\Commands";s:18:"declaringClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:21:"implementingClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:16:"currentClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:9:"aliasName";N;}s:23:"reportDuplicateActivity";a:20:{s:4:"name";s:23:"reportDuplicateActivity";s:10:"parameters";a:1:{s:10:"campaignId";a:13:{s:4:"name";s:10:"campaignId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:131;s:7:"endLine";i:131;s:11:"startColumn";i:46;s:9:"endColumn";i:60;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:288:"/**
 * Tail of the duplicate audit trail — the 10 most recent events.
 *
 * Served by the created_at index on duplicate_logs, so this stays fast
 * even as the table grows. custom_fields is truncated to keep the CLI
 * table readable; the full payload is in the DB / duplicates.log.
 */";s:9:"startLine";i:131;s:7:"endLine";i:153;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:20:"App\Console\Commands";s:18:"declaringClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:21:"implementingClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:16:"currentClassName";s:38:"App\Console\Commands\CampaignAnalytics";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}